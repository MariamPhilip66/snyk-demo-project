# TaskFlow API - Environment Configuration
# IMPORTANT: Never commit this file to version control

PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=taskflow_app
DB_PASSWORD=change_me_in_production
DB_NAME=taskflow_dev
DB_PORT=3306

# JWT
JWT_SECRET=change_this_to_a_random_256bit_key
JWT_EXPIRY=24h

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
